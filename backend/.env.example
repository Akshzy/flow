# Floww backend environment (Phase 1)
# Copy this file to backend/.env and fill in values. NEVER commit real secrets.

# Application environment: development | test | production
ENVIRONMENT=development

# PostgreSQL connection string (required, no default).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# For local development with the embedded PostgreSQL (npm run db:up):
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55432/floww

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Render logs as JSON lines (recommended for production); false = console format
LOG_JSON=false
